// Generated by WLEDtoy graph mode
uniform highp sampler2D iGlobal;
// blend-multiply
vec3 node_mix_mul(float t, vec3 col1, vec3 col2)
{
  return mix(col1, col1 * col2, t);
}

// blend-add
vec3 node_mix_add(float t, vec3 col1, vec3 col2)
{
  return mix(col1, col1 + col2, t);
}

// blend-lighten
vec3 node_mix_light(float t, vec3 col1, vec3 col2)
{
  return mix(col1, max(col1, col2), t);
}

// blend-screen
vec3 node_mix_screen(float t, vec3 col1, vec3 col2)
{
  float tm = 1.0 - t;

  return vec3(1.0) - (vec3(tm) + t * (vec3(1.0) - col2)) * (vec3(1.0) - col1);
}

void mainImage(out vec4 c, vec2 uv, float ledIndex) {
  c = vec4(0.0, 0.0, 0.0, 1.0);
  float n_sparkle = sparkle(ledIndex, 0.15, 3.0);
  vec3 n_sparkColor = vec3(n_sparkle, n_sparkle, n_sparkle);
  vec3 n_spark = clamp(node_mix_mul(clamp(1.0, 0.0, 1.0), texelFetch(iGlobal, ivec2(0, 0), 0).xyz, n_sparkColor), 0.0, 1.0);
  float n_scan = scanner(uv.x, 2.0, 0.05);
  vec3 n_scanColor = vec3(n_scan, n_scan, n_scan);
  vec3 n_seed = clamp(node_mix_add(clamp(0.6, 0.0, 1.0), n_spark, n_scanColor), 0.0, 1.0);
  vec3 n_trails = max(n_seed, previousFrame(1.0) * exp(-iTimeDelta / max(1.5, 0.0001)));
  float n_blur_spread = 8.0;
  vec3 n_blur_blurred = 0.25 * previousFrame(-n_blur_spread) + 0.5 * previousFrame(0.0) + 0.25 * previousFrame(n_blur_spread);
  vec3 n_blur = max(n_trails, n_blur_blurred * exp(-iTimeDelta / max(0.8, 0.0001)));
  vec3 n_prev1 = previousFrame(3.0);
  vec3 n_prev2 = previousFrame(-3.0);
  vec3 n_echo = clamp(node_mix_light(clamp(0.5, 0.0, 1.0), n_prev1, n_prev2), 0.0, 1.0);
  vec3 n_stack = clamp(node_mix_screen(clamp(0.45, 0.0, 1.0), n_blur, n_echo), 0.0, 1.0);
  vec3 n_trails2 = max(n_stack, previousFrame(-1.0) * exp(-iTimeDelta / max(0.6, 0.0001)));
  vec3 n_lift = clamp(node_mix_mul(clamp(1.0, 0.0, 1.0), n_trails2, texelFetch(iGlobal, ivec2(1, 0), 0).xyz), 0.0, 1.0);
  c = vec4(n_lift, 1.0);
}
