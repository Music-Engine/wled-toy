// Generated by WLEDtoy graph mode
uniform highp sampler2D iGlobal;
// common
#define M_PI 3.1415926535897932384626433832795
#define M_2PI 6.283185307179586476925286766559

// https://www.shadertoy.com/view/3sd3Rs
float node_hash(float n) { return fract(sin(n) * 1e4); }
float node_hash(vec2 p) { return fract(1e4 * sin(17.0 * p.x + p.y * 0.1) * (0.1 + abs(sin(p.y * 13.0 + p.x)))); }

// noise
// Lattice cells wrap every 256 so the hash argument stays small: sin() of a large float is 0 on some GPUs,
// which painted every negative coordinate one flat value. Wrapping the corners too keeps the seams continuous.
float lattice_hash(float c) { return node_hash(mod(c, 256.0)); }
float lattice_hash(vec2 c) { return node_hash(mod(c, 256.0)); }
float lattice_hash(vec3 c) { return node_hash(dot(mod(c, 256.0), vec3(110, 241, 171))); }

float noise1(float x) {
	float i = floor(x);
	float f = fract(x);
	float u = f * f * (3.0 - 2.0 * f);
	return mix(lattice_hash(i), lattice_hash(i + 1.0), u);
}

float noise2(vec2 x) {
	vec2 i = floor(x);
	vec2 f = fract(x);

	// Four corners in 2D of a tile
	float a = lattice_hash(i);
	float b = lattice_hash(i + vec2(1.0, 0.0));
	float c = lattice_hash(i + vec2(0.0, 1.0));
	float d = lattice_hash(i + vec2(1.0, 1.0));

	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
}

float noise3(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);

	vec3 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix( lattice_hash(i + vec3(0, 0, 0)), lattice_hash(i + vec3(1, 0, 0)), u.x),
                   mix( lattice_hash(i + vec3(0, 1, 0)), lattice_hash(i + vec3(1, 1, 0)), u.x), u.y),
               mix(mix( lattice_hash(i + vec3(0, 0, 1)), lattice_hash(i + vec3(1, 0, 1)), u.x),
                   mix( lattice_hash(i + vec3(0, 1, 1)), lattice_hash(i + vec3(1, 1, 1)), u.x), u.y), u.z);
}

// GLSL equivalent of noise_fbm
float noise_fbm(vec3 co, float detail, float roughness, float lacunarity, bool use_normalize) {
    vec3 p = co;
    float fscale = 1.0;
    float amp = 1.0;
    float maxamp = 0.0;
    float sum = 0.0;

    // a runtime float as the bound can spin forever on a bad link; 15 octaves is past visible detail
    int octaves = int(clamp(detail, 0.0, 15.0));
    for (int i = 0; i <= octaves; i++) {
        float t = noise3(fscale * p);
        sum += t * amp;
        maxamp += amp;
        amp *= roughness;
        fscale *= lacunarity;
    }

    float rmd = detail - floor(detail);
    if (rmd != 0.0) {
        float t = noise3(fscale * p);
        float sum2 = sum + t * amp;
        return use_normalize ?
               mix(sum / maxamp, sum2 / (maxamp + amp), rmd) :
               mix(sum, sum2, rmd);
    }
    else {
        return use_normalize ? sum / maxamp : sum;
    }
}

// blend-overlay
vec3 node_mix_overlay(float t, vec3 col1, vec3 col2)
{
  float tm = 1.0 - t;

  vec3 outcol = col1;

  if (outcol[0] < 0.5) {
    outcol[0] *= tm + 2.0 * t * col2[0];
  }
  else {
    outcol[0] = 1.0 - (tm + 2.0 * t * (1.0 - col2[0])) * (1.0 - outcol[0]);
  }

  if (outcol[1] < 0.5) {
    outcol[1] *= tm + 2.0 * t * col2[1];
  }
  else {
    outcol[1] = 1.0 - (tm + 2.0 * t * (1.0 - col2[1])) * (1.0 - outcol[1]);
  }

  if (outcol[2] < 0.5) {
    outcol[2] *= tm + 2.0 * t * col2[2];
  }
  else {
    outcol[2] = 1.0 - (tm + 2.0 * t * (1.0 - col2[2])) * (1.0 - outcol[2]);
  }

  return outcol;
}

// magic-texture
vec3 magic(vec3 p, float scale, int n, float distortion)
{
  float dist = distortion;

  float a = mod(p.x * scale, M_2PI);
  float b = mod(p.y * scale, M_2PI);
  float c = mod(p.z * scale, M_2PI);

  float x = sin((a + b + c) * 5.0);
  float y = cos((-a + b - c) * 5.0);
  float z = -cos((-a - b + c) * 5.0);

  if (n > 0) {
    x *= dist;
    y *= dist;
    z *= dist;
    y = -cos(x - y + z);
    y *= dist;

    if (n > 1) {
      x = cos(x - y - z);
      x *= dist;

      if (n > 2) {
        z = sin(-x - y - z);
        z *= dist;

        if (n > 3) {
          x = -cos(-x + y - z);
          x *= dist;

          if (n > 4) {
            y = -sin(-x + y + z);
            y *= dist;

            if (n > 5) {
              y = -cos(-x + y + z);
              y *= dist;

              if (n > 6) {
                x = cos(x + y + z);
                x *= dist;

                if (n > 7) {
                  z = sin(x + y - z);
                  z *= dist;

                  if (n > 8) {
                    x = -cos(-x - y + z);
                    x *= dist;

                    if (n > 9) {
                      y = -sin(x - y + z);
                      y *= dist;
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  if (dist != 0.0) {
    dist *= 2.0;
    x /= dist;
    y /= dist;
    z /= dist;
  }

  return vec3(0.5 - x, 0.5 - y, 0.5 - z);
}

void magic_texture(
    int depth,
    float distortion,
    float scale,
    vec3 vector,
    out float fac,
    out vec3 color)
{
  color = magic(vector, scale, depth, distortion);
  fac = (color.r + color.g + color.b) * (1.0 / 3.0);
}

// blend-screen
vec3 node_mix_screen(float t, vec3 col1, vec3 col2)
{
  float tm = 1.0 - t;

  return vec3(1.0) - (vec3(tm) + t * (vec3(1.0) - col2)) * (vec3(1.0) - col1);
}

// color-rgb-to-hsv
vec3 rgb_to_hsv(vec3 rgb)
{
  float cmax, cmin, h, s, v, cdelta;
  vec3 c;

  cmax = max(rgb[0], max(rgb[1], rgb[2]));
  cmin = min(rgb[0], min(rgb[1], rgb[2]));
  cdelta = cmax - cmin;

  v = cmax;

  if (cmax != 0.0) {
    s = cdelta / cmax;
  }
  else {
    s = 0.0;
    h = 0.0;
  }

  if (s == 0.0) {
    h = 0.0;
  }
  else {
    c = (vec3(cmax, cmax, cmax) - rgb) / cdelta;

    if (rgb[0] == cmax) {
      h = c[2] - c[1];
    }
    else if (rgb[1] == cmax) {
      h = 2.0 + c[0] - c[2];
    }
    else {
      h = 4.0 + c[1] - c[0];
    }

    h /= 6.0;

    if (h < 0.0) {
      h += 1.0;
    }
  }

  return vec3(h, s, v);
}

// color-hsv-to-rgb
vec3 hsv_to_rgb(vec3 hsv)
{
  float i, f, p, q, t, h, s, v;
  vec3 rgb;

  // Blender only folds h == 1.0 back to 0; hue is a circle, so anything outside 0..1 wraps
  h = fract(hsv[0]);
  s = hsv[1];
  v = hsv[2];

  if (s == 0.0) {
    rgb = vec3(v, v, v);
  }
  else {
    h *= 6.0;
    i = floor(h);
    f = h - i;
    rgb = vec3(f, f, f);
    p = v * (1.0 - s);
    q = v * (1.0 - (s * f));
    t = v * (1.0 - (s * (1.0 - f)));

    if (i == 0.0) {
      rgb = vec3(v, t, p);
    }
    else if (i == 1.0) {
      rgb = vec3(q, v, p);
    }
    else if (i == 2.0) {
      rgb = vec3(p, v, t);
    }
    else if (i == 3.0) {
      rgb = vec3(p, q, v);
    }
    else if (i == 4.0) {
      rgb = vec3(t, p, v);
    }
    else {
      rgb = vec3(v, p, q);
    }
  }

  return rgb;
}

// blend-add
vec3 node_mix_add(float t, vec3 col1, vec3 col2)
{
  return mix(col1, col1 + col2, t);
}

void mainImage(out vec4 c, vec2 uv, float ledIndex) {
  c = vec4(0.0, 0.0, 0.0, 1.0);
  vec3 n_map_p = (vec3(uv, 0.0) - vec3(0.5, 0.5, 0.0)) * vec3(3.0, 3.0, 1.0);
  float n_map_a = 0.1 * 6.2831853;
  vec3 n_map = vec3(n_map_p.x * cos(n_map_a) + n_map_p.y * sin(n_map_a), n_map_p.y * cos(n_map_a) - n_map_p.x * sin(n_map_a), n_map_p.z) + vec3(0.5, 0.5, 0.0) + texelFetch(iGlobal, ivec2(0, 0), 0).xyz;
  vec3 n_noise_p = n_map * 8.0;
  vec3 n_noise_warped = n_noise_p + 2.0 * (vec3(noise3(n_noise_p + 13.5), noise3(n_noise_p), noise3(n_noise_p - 13.5)) * 2.0 - 1.0);
  float n_noise_fac = noise_fbm(n_noise_warped, 15.0, 0.9, 2.0, true);
  vec3 n_noise_color = vec3(n_noise_fac, noise_fbm(n_noise_warped.yxz + 27.1, 15.0, 0.9, 2.0, true), noise_fbm(n_noise_warped.zyx - 41.3, 15.0, 0.9, 2.0, true));
  vec2 n_voronoi_p = n_map.xy * 12.0;
  vec2 n_voronoi_cell = floor(n_voronoi_p);
  float n_voronoi_best = 8.0; vec2 n_voronoi_nearest = n_voronoi_cell;
  for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) {
    vec2 g = n_voronoi_cell + vec2(float(i), float(j));
    vec2 o = g + 0.5 + (vec2(node_hash(g), node_hash(g + 19.1)) - 0.5) * 1.0;
    float d = distance(o, n_voronoi_p);
    if (d < n_voronoi_best) { n_voronoi_best = d; n_voronoi_nearest = o; }
  }
  float n_voronoi_distance = n_voronoi_best;
  vec3 n_voronoi_color = vec3(node_hash(n_voronoi_nearest), node_hash(n_voronoi_nearest + 7.7), node_hash(n_voronoi_nearest + 13.9));
  vec3 n_voronoi_position = vec3(n_voronoi_nearest / 12.0, 0.0);
  vec3 n_blend = clamp(node_mix_overlay(clamp(0.5, 0.0, 1.0), n_noise_color, n_voronoi_color), 0.0, 1.0);
  float n_magic_fac; vec3 n_magic_color; magic_texture(10, 2.0, 9.0, n_map, n_magic_fac, n_magic_color);
  vec3 n_shared = clamp(node_mix_screen(clamp(0.5, 0.0, 1.0), n_blend, n_magic_color), 0.0, 1.0);
  vec3 n_tap0_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap0 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap0_hsv.x + 0.0), clamp(n_tap0_hsv.y * 1.0, 0.0, 1.0), n_tap0_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_tap1_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap1 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap1_hsv.x + 0.0625), clamp(n_tap1_hsv.y * 1.0, 0.0, 1.0), n_tap1_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_sum0_0 = clamp(node_mix_add(clamp(0.5, 0.0, 1.0), n_tap0, n_tap1), 0.0, 1.0);
  vec3 n_tap2_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap2 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap2_hsv.x + 0.125), clamp(n_tap2_hsv.y * 1.0, 0.0, 1.0), n_tap2_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_tap3_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap3 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap3_hsv.x + 0.1875), clamp(n_tap3_hsv.y * 1.0, 0.0, 1.0), n_tap3_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_sum0_2 = clamp(node_mix_add(clamp(0.5, 0.0, 1.0), n_tap2, n_tap3), 0.0, 1.0);
  vec3 n_sum1_0 = clamp(node_mix_add(clamp(0.5, 0.0, 1.0), n_sum0_0, n_sum0_2), 0.0, 1.0);
  vec3 n_tap4_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap4 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap4_hsv.x + 0.25), clamp(n_tap4_hsv.y * 1.0, 0.0, 1.0), n_tap4_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_tap5_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap5 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap5_hsv.x + 0.3125), clamp(n_tap5_hsv.y * 1.0, 0.0, 1.0), n_tap5_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_sum0_4 = clamp(node_mix_add(clamp(0.5, 0.0, 1.0), n_tap4, n_tap5), 0.0, 1.0);
  vec3 n_tap6_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap6 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap6_hsv.x + 0.375), clamp(n_tap6_hsv.y * 1.0, 0.0, 1.0), n_tap6_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_tap7_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap7 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap7_hsv.x + 0.4375), clamp(n_tap7_hsv.y * 1.0, 0.0, 1.0), n_tap7_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_sum0_6 = clamp(node_mix_add(clamp(0.5, 0.0, 1.0), n_tap6, n_tap7), 0.0, 1.0);
  vec3 n_sum1_2 = clamp(node_mix_add(clamp(0.5, 0.0, 1.0), n_sum0_4, n_sum0_6), 0.0, 1.0);
  vec3 n_sum2_0 = clamp(node_mix_add(clamp(0.5, 0.0, 1.0), n_sum1_0, n_sum1_2), 0.0, 1.0);
  vec3 n_tap8_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap8 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap8_hsv.x + 0.5), clamp(n_tap8_hsv.y * 1.0, 0.0, 1.0), n_tap8_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_tap9_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap9 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap9_hsv.x + 0.5625), clamp(n_tap9_hsv.y * 1.0, 0.0, 1.0), n_tap9_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_sum0_8 = clamp(node_mix_add(clamp(0.5, 0.0, 1.0), n_tap8, n_tap9), 0.0, 1.0);
  vec3 n_tap10_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap10 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap10_hsv.x + 0.625), clamp(n_tap10_hsv.y * 1.0, 0.0, 1.0), n_tap10_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_tap11_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap11 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap11_hsv.x + 0.6875), clamp(n_tap11_hsv.y * 1.0, 0.0, 1.0), n_tap11_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_sum0_10 = clamp(node_mix_add(clamp(0.5, 0.0, 1.0), n_tap10, n_tap11), 0.0, 1.0);
  vec3 n_sum1_4 = clamp(node_mix_add(clamp(0.5, 0.0, 1.0), n_sum0_8, n_sum0_10), 0.0, 1.0);
  vec3 n_tap12_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap12 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap12_hsv.x + 0.75), clamp(n_tap12_hsv.y * 1.0, 0.0, 1.0), n_tap12_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_tap13_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap13 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap13_hsv.x + 0.8125), clamp(n_tap13_hsv.y * 1.0, 0.0, 1.0), n_tap13_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_sum0_12 = clamp(node_mix_add(clamp(0.5, 0.0, 1.0), n_tap12, n_tap13), 0.0, 1.0);
  vec3 n_tap14_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap14 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap14_hsv.x + 0.875), clamp(n_tap14_hsv.y * 1.0, 0.0, 1.0), n_tap14_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_tap15_hsv = rgb_to_hsv(n_shared);
  vec3 n_tap15 = mix(n_shared, max(hsv_to_rgb(vec3(fract(n_tap15_hsv.x + 0.9375), clamp(n_tap15_hsv.y * 1.0, 0.0, 1.0), n_tap15_hsv.z * 1.0)), vec3(0.0)), 1.0);
  vec3 n_sum0_14 = clamp(node_mix_add(clamp(0.5, 0.0, 1.0), n_tap14, n_tap15), 0.0, 1.0);
  vec3 n_sum1_6 = clamp(node_mix_add(clamp(0.5, 0.0, 1.0), n_sum0_12, n_sum0_14), 0.0, 1.0);
  vec3 n_sum2_2 = clamp(node_mix_add(clamp(0.5, 0.0, 1.0), n_sum1_4, n_sum1_6), 0.0, 1.0);
  vec3 n_sum3_0 = clamp(node_mix_add(clamp(0.5, 0.0, 1.0), n_sum2_0, n_sum2_2), 0.0, 1.0);
  vec3 n_ceiling_in = n_sum3_0;
  vec3 n_ceiling = n_ceiling_in * min(1.0, 0.9 / max(max(n_ceiling_in.r, max(n_ceiling_in.g, n_ceiling_in.b)), 0.0001));
  c = vec4(n_ceiling, 1.0);
}
