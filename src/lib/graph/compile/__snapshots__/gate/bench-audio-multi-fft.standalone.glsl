  float n_bandSum0_16 = clamp(n_bandSum0_15 + n_bands0_band16, 0.0, 1.0);
  float n_gain0 = clamp(iAudioFeatures[0].x + n_bandSum0_16, 0.0, 1.0);
  float n_bands1_band1 = bandsPeak(2, 0, 16);
