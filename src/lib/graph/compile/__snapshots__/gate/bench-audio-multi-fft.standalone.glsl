  float n_bands2_band1 = bandsPeak(3, 0, 16);
  float n_bands2_band2 = bandsPeak(3, 1, 16);
  float n_bands2_band3 = bandsPeak(3, 2, 16);
  float n_bands2_band4 = bandsPeak(3, 3, 16);
  float n_bands2_band5 = bandsPeak(3, 4, 16);
