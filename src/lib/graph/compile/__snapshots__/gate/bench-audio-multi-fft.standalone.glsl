  float n_bands0_band8 = bandsPeak(1, 7, 16);
  float n_bands0_band9 = bandsPeak(1, 8, 16);
  float n_bands0_band10 = bandsPeak(1, 9, 16);
  float n_bands0_band11 = bandsPeak(1, 10, 16);
